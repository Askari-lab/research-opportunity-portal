    },
    {
      "name": "9 - Delete opportunity",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/opportunities/{{opportunityId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted (200)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Deleted opportunity returns 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/opportunities/{{opportunityId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Not found (404)', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}